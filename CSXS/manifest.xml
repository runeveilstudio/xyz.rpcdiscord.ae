<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest
	Version="8.0"
	ExtensionBundleId="xyz.rpcdiscord.ae"
	ExtensionBundleVersion="2.0.0"
	ExtensionBundleName="AE Discord RPC - Runeveil Studio"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

	<ExtensionList>
		<Extension Id="xyz.rpcdiscord.ae.panel" Version="1.0" />
	</ExtensionList>

	<ExecutionEnvironment>
		<HostList>
			<Host Name="AEFT" Version="[13.0,99.9]"/>
		</HostList>

	<LocaleList>
		<Locale Code="All" />
	</LocaleList>

	<RequiredRuntimeList>
		<RequiredRuntime Name="CSXS" Version="8.0" />
	</RequiredRuntimeList>
</ExecutionEnvironment>

	<DispatchInfoList>
		<Extension Id="xyz.rpcdiscord.ae.panel">
			<DispatchInfo>

			<Resources>
				<MainPath>./client/index.html</MainPath>
				<ScriptPath>./host/index.jsx</ScriptPath>
				<CEFCommandLine>
					<Parameter>--enable-nodejs=false</Parameter>
					<Parameter>--allow-file-access-from-files</Parameter>
					<Parameter>--allow-file-access</Parameter>
				</CEFCommandLine>
			</Resources>

			<Lifecycle>
				<AutoVisible>true</AutoVisible>
			</Lifecycle>

			<UI>
				<Type>Panel</Type>
				<Menu>Discord Status</Menu>
				<Geometry>
					<Size>
						<Height>480</Height>
						<Width>320</Width>
					</Size>
					<MinSize>
						<Height>260</Height>
						<Width>220</Width>
					</MinSize>
					<MaxSize>
						<Height>900</Height>
						<Width>800</Width>
					</MaxSize>
				</Geometry>
			</UI>
		</DispatchInfo>
	</Extension>
</DispatchInfoList>
</ExtensionManifest>
